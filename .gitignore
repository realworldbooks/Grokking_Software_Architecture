# ==============================================================================
# Multi-Language .gitignore for Architecture Book Repo
# Covers: C# (.NET), Java (Maven), Python, JavaScript (Node.js)
# ==============================================================================

# ------------------------------------------------------------------------------
# General OS and Editor/IDE Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# C# / .NET
# ------------------------------------------------------------------------------
# Build results
bin/
obj/

# Visual Studio / Rider cache and settings
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet Packages
packages/
*.nupkg
*.snupkg

# ------------------------------------------------------------------------------
# Java / Maven
# ------------------------------------------------------------------------------
# Compiled class files
*.class

# Package Files
*.jar
*.war
*.ear
*.nar

# Build directories
target/
build/
.gradle/

# JVM Crash logs
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
# Python
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/

# Testing and Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# ------------------------------------------------------------------------------
# JavaScript / Node.js
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
.pnp
.pnp.js

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/

# Environment Variables (Keep these out of version control!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

#local db
*.db