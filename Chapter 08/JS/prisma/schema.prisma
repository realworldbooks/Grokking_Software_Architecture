// THE DATABASE CONTEXT (Infrastructure Layer):
// This defines the connection to our SQLite database.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./orm_demo.db"
}

/// THE DOMAIN MODEL (Declarative Mapping):
/// TEACHING NOTE:
/// In the old days, you had to write a 'CREATE TABLE' SQL string by hand.
/// With Prisma, you simply define a schema model. The ORM reads this 
/// and automatically generates the perfect database schema for you.
model User {
  id        Int     @id @default(autoincrement())
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  age       Int
  isActive  Boolean @map("is_active")

  // Map the model to a specific table name
  @@map("users")
}