// demo.js
import { SqliteDatabase } from './infrastructure/sqliteDatabase.js';
import { NoSqlSimulator } from './infrastructure/noSqlSimulator.js';
import { VectorDbSimulator } from './infrastructure/vectorDbSimulator.js';
import { MockOpenAiService } from './services/mockOpenAiService.js';

export class Demo {
    static run() {
        console.log("=== Section 8.1.4: SQL vs. NoSQL vs. Vector ===\n");

        console.log("--- The SQL Way (Relational) ---");
        const sqlDb = new SqliteDatabase();
        sqlDb.insert(1, "Lasagna", "Pasta");
        
        console.log(`Querying for 'Pasta' -> Found: [${sqlDb.queryByType("Pasta")}]`);
        console.log(`Querying for 'Comfort Food' -> Found: [${sqlDb.queryByType("Comfort Food")}]\n`);

        console.log("--- The NoSQL Way (Document) ---");
        const nosqlDb = new NoSqlSimulator();
        nosqlDb.insertOne({
            name: "Lasagna",
            tags: ["pasta", "cheese", "italian", "dinner"]
        });
        
        console.log(`Querying tags for 'pasta' -> Found: [${nosqlDb.findByTag("pasta")}]\n`);

        console.log("--- The Vector Way (AI Embeddings) ---");
        const vectorDb = new VectorDbSimulator();
        
        const lasagnaVector = MockOpenAiService.createEmbedding("Lasagna");
        vectorDb.upsert("recipe_1", lasagnaVector, { name: "Lasagna" });

        const queryVector = MockOpenAiService.createEmbedding("Comfort Food");
        console.log(`Vector DB found closest meaning -> [${vectorDb.query(queryVector, 1)}]\n`);
    }
}